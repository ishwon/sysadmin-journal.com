<div class="reading-progress" aria-hidden="true" x-data="{
    update() {
        const el = document.getElementById('post-body');
        if (!el) return;
        const total = el.offsetHeight - window.innerHeight + el.offsetTop;
        const scrolled = Math.max(0, window.scrollY - el.offsetTop);
        const pct = Math.min(100, Math.max(0, (scrolled / Math.max(1, total)) * 100));
        this.$refs.fill.style.width = pct + '%';
    }
}" x-init="update()" x-on:scroll.window="update()" x-on:resize.window="update()">
    <div class="reading-progress-fill" x-ref="fill"></div>
</div>

<article class="px-6 pt-16 pb-24">
    <header class="max-w-measure mx-auto text-lg">
        <p class="eyebrow">
            <a href="/" class="link-rise">/journal/</a><% if let Some(tag) = &post.primary_tag { %><a href="/tag/<%= tag.slug %>" class="link-rise"><%= tag.slug %>/</a><% } %>
        </p>
        <h1 class="display text-4xl md:text-[52px] md:leading-[1.08] mt-4"><%= post.title %></h1>
        <% if !post.excerpt.is_empty() { %>
            <p class="mt-5 font-display italic text-[22px] leading-snug text-ink-500 text-pretty [&_a]:text-accent-700 hover:[&_a]:underline"><%- post.excerpt %></p>
        <% } %>
        <div class="mt-7 pt-4 border-t border-ink-100 flex items-center gap-3 meta">
            <% if let Some(author) = &post.primary_author { %>
                <a href="/author/<%= author.slug %>" class="shrink-0">
                    <span class="sr-only"><%= author.name %></span>
                    <% if let Some(image) = author.profile_image.as_deref().filter(|i| !i.is_empty()) { %>
                        <img class="h-7 w-7 rounded-full" src="<%= image %>" alt="">
                    <% } else { %>
                        <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-ink-800 text-white font-display text-xs"><%= initials(&author.name) %></span>
                    <% } %>
                </a>
                <a href="/author/<%= author.slug %>" class="text-ink-900 hover:text-accent-700 transition-colors"><%= author.name %></a>
                <span aria-hidden="true">·</span>
            <% } %>
            <time datetime="<%= date(&post.published_at, "Y-m-d") %>"><%= date(&post.published_at, "j F Y") %></time>
            <span aria-hidden="true">·</span>
            <span><%= post.reading_time %> min read</span>
        </div>
    </header>

    <% if let Some(image) = post.feature_image.as_deref().filter(|i| !i.is_empty()) { %>
        <figure class="mt-12 max-w-4xl mx-auto">
            <img class="w-full border-b border-ink-100" src="<%= image %>" alt="<%= s(&post.feature_image_alt) %>" loading="eager">
            <% if let Some(caption) = post.feature_image_caption.as_deref().filter(|c| !c.is_empty()) { %>
                <figcaption class="mt-2.5 meta leading-relaxed"><%- caption %></figcaption>
            <% } %>
        </figure>
    <% } %>

    <div id="post-body" class="prose-brand mt-12 max-w-measure mx-auto">
        <%- s(&post.html) %>
        <p class="section-end" aria-hidden="true">॥</p>
    </div>

    <% include!("../components/post-gallery.stpl"); %>

    <% if previous.is_some() || next.is_some() { %>
        <footer class="max-w-measure mx-auto mt-12 pt-6 border-t border-ink-100 flex justify-between gap-6 meta">
            <% if let Some(previous) = &previous { %><a href="/<%= previous.slug %>" class="link-rise">← <%= previous.title %></a><% } else { %><span></span><% } %>
            <% if let Some(next) = &next { %><a href="/<%= next.slug %>" class="link-rise text-right"><%= next.title %> →</a><% } %>
        </footer>
    <% } %>
</article>
