<%- ui::table_open(&["name", "email", "posts", ""]) %>
    <% if users.data.is_empty() { %>
        <tr><td colspan="4" class="py-10">
            <%- ui::empty_state("No users yet", None, Some(ui::button("primary").href("/dashboard/users/create").html("Create user"))) %>
        </td></tr>
    <% } %>
    <% for user in &users.data { %>
        <tr>
            <td>
                <div class="flex items-center gap-3">
                    <% if let Some(image) = user.profile_image.as_deref().filter(|i| !i.is_empty()) { %>
                        <img class="h-8 w-8 rounded-full" src="<%= image %>" alt="">
                    <% } else { %>
                        <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-ink-800 text-white font-display text-[13px]"><%= initials(&user.name) %></span>
                    <% } %>
                    <div>
                        <a href="/dashboard/users/<%= user.id %>/edit" class="font-display text-lg text-ink-900 hover:text-accent-700 transition-colors"><%= user.name %></a>
                        <p class="meta mt-0.5">/author/<%= user.slug %></p>
                    </div>
                </div>
            </td>
            <td class="meta"><%= user.email %></td>
            <td class="meta"><%= user.posts_count %></td>
            <td class="text-right whitespace-nowrap meta">
                <a href="/dashboard/users/<%= user.id %>/edit" class="link-rise">edit</a>
                <span class="text-ink-200"> · </span>
                <a href="/author/<%= user.slug %>" target="_blank" class="link-rise">view</a>
                <% if base.user_id() != Some(user.id) { %>
                    <span class="text-ink-200"> · </span>
                    <%- ui::delete_form(&format!("/dashboard/users/{}", user.id), "Delete this user?", &base.csrf_field()) %>
                <% } %>
            </td>
        </tr>
    <% } %>
<%- ui::table_close(ui::links_footer(&users)) %>
