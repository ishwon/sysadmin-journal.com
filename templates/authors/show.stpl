<div class="max-w-[1120px] mx-auto px-6 pt-16 pb-24">
    <header class="pb-6 border-b border-ink-100 flex flex-col sm:flex-row gap-6 items-start">
        <% if let Some(image) = author.profile_image.as_deref().filter(|i| !i.is_empty()) { %>
            <img class="h-20 w-20 rounded-full shrink-0" src="<%= image %>" alt="<%= author.name %>">
        <% } else { %>
            <span class="inline-flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-ink-800 text-white font-display text-[28px]"><%= initials(&author.name) %></span>
        <% } %>
        <div>
            <p class="eyebrow">/author/<%= author.slug %>/</p>
            <h1 class="display text-4xl mt-2"><%= author.name %></h1>
            <% if let Some(bio) = author.bio.as_deref().filter(|b| !b.is_empty()) { %>
                <p class="mt-3 font-serif text-lg leading-relaxed text-ink-500 max-w-[60ch] text-pretty"><%= bio %></p>
            <% } %>
            <p class="meta mt-3"><%= posts.total %> <%= plural("post", posts.total) %></p>
        </div>
    </header>

    <div class="grid gap-x-12 sm:grid-cols-2 lg:grid-cols-3">
        <% for post in &posts.data { %>
            <% include!("../components/post-card.stpl"); %>
        <% } %>
    </div>

    <% include!("../components/pagination.stpl"); %>
</div>
