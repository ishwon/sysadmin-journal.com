APP_NAME="SysAdmin Journal"
APP_ENV=local
# 32+ random bytes, base64 encoded. Laravel-style "base64:..." keys are accepted.
# Generate one with: openssl rand -base64 32
APP_KEY=
APP_URL=http://localhost:8000

# Address the HTTP server binds to.
APP_HOST=127.0.0.1
APP_PORT=8000

# SQLite database file. Relative paths resolve from the working directory.
DATABASE_URL=sqlite:database/database.sqlite

# Session lifetime in minutes (sliding expiry).
SESSION_LIFETIME=120

# Password hashing cost.
BCRYPT_ROUNDS=12

# Filesystem locations (relative to the working directory unless absolute).
PUBLIC_DIR=public
MEDIA_DIR=storage/app/public

# Log verbosity: error, warn, info, debug, trace.
RUST_LOG=info
